# ==========================================
# Entornos Virtuales y Python
# ==========================================
nasa/
venv/
.venv/
env/
ENV/

# Caché y compilación de Python
__pycache__/
*.py[cod]
*$py.class
*.so

# Pruebas y análisis estático
.pytest_cache/
.mypy_cache/
.ruff_cache/

# Distribución y empaquetado
build/
dist/
*.egg-info/
.eggs/

# ==========================================
# Frontend (Node / Vite / React)
# ==========================================
node_modules/
frontend/node_modules/
dist/
frontend/dist/
dist-ssr/
*.local

# Logs
logs/
*.log
npm-debug.log*
yarn-debug.log*
yarn-error.log*
pnpm-debug.log*
lerna-debug.log*

# ==========================================
# Variables de Entorno y Credenciales
# ==========================================
.env
.env.local
.env.*.local
*.env

