# Conexión a MongoDB (Atlas o contenedor local del docker-compose)
# Atlas:        mongodb+srv://<usuario>:<password>@<cluster>.mongodb.net/?retryWrites=true&w=majority
# Local docker: mongodb://mongo:27017/nasa_space
MONGO_URI=mongodb+srv://USUARIO:PASSWORD@CLUSTER.mongodb.net/?retryWrites=true&w=majority

# Credenciales Meteomatics REST API (pipeline/fetch_meteomatics.py)
METEOMATICS_USER=
METEOMATICS_PASSWORD=

# Google Earth Engine (pipeline/common.py → init_ee)
# Si se omite, se usa gen-lang-client-0793724758
GEE_PROJECT_ID=gen-lang-client-0793724758

# Servidor FastAPI
PORT=8000
HOST=0.0.0.0
