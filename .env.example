# Conexión a MongoDB Atlas o contenedor local
# Ejemplo Atlas: mongodb+srv://<usuario>:<password>@cluster.mongodb.net/?retryWrites=true&w=majority
# Ejemplo local/docker: mongodb://mongo:27017/analogos
MONGO_URI="mongodb+srv://<usuario>:<password>@cluster.mongodb.net/?retryWrites=true&w=majority"

# Credenciales Meteomatics REST API (Plan Weather API)
METEOMATICS_USER="tu_usuario"
METEOMATICS_PASSWORD="tu_password"

# Configuración del Servidor FastAPI
PORT=8000
HOST="0.0.0.0"
